# ==========================================
# AgriSense AI - Environment Configuration
# ==========================================

# -----------------
# Server Environment
# -----------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-admin-only

# Google Gemini AI SDK
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Weather API (OpenWeather)
WEATHER_API_KEY=your-openweather-api-key-optional
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Server Rate Limiting & File Upload Limits
MAX_IMAGE_SIZE_MB=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------
# Client Environment
# -----------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
